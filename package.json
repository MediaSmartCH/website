{
  "name": "sparklet.ai",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://www.mediasmart.ch",
  "repository": {
    "type": "git",
    "url": "https://github.com/MediaSmartCH/website.git"
  },
  "bugs": {
    "url": "https://github.com/MediaSmartCH/website/issues"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.16",
    "@reduxjs/toolkit": "^2.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "antd": "^6.6.4",
    "aos": "^2.3.4",
    "dompurify": "^3.4.15",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-international-phone": "^4.8.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.4",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-persist-transform-filter": "^0.0.22",
    "resend": "^6.28.1"
  },
  "scripts": {
    "dev": "node scripts/clean-workspace.mjs && vite",
    "api": "node scripts/dev-api.mjs",
    "google:token": "node scripts/google-oauth-token.mjs",
    "build": "node scripts/fetch-tool-stats.mjs && node scripts/generate-image-variants.mjs && node scripts/generate-localized-html.mjs && vite build && node scripts/prerender.mjs && node scripts/emit-static-404.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
    "preview": "vite preview",
    "analyze": "node scripts/fetch-tool-stats.mjs && node scripts/generate-image-variants.mjs && node scripts/generate-localized-html.mjs && cross-env ANALYZE=true vite build && node scripts/prerender.mjs && node scripts/emit-static-404.mjs",
    "clean": "node scripts/clean-workspace.mjs",
    "clean:dry-run": "node scripts/clean-workspace.mjs --dry-run --verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "vercel:sync:project": "node scripts/sync-vercel-project-settings.mjs",
    "vercel:sync:project:dry-run": "node scripts/sync-vercel-project-settings.mjs --dry-run",
    "vercel:sync:domains": "node scripts/sync-vercel-domain-settings.mjs",
    "vercel:sync:domains:dry-run": "node scripts/sync-vercel-domain-settings.mjs --dry-run",
    "vercel:sync": "pnpm run vercel:sync:project && pnpm run vercel:sync:domains",
    "vercel:sync:dry-run": "pnpm run vercel:sync:project:dry-run && pnpm run vercel:sync:domains:dry-run",
    "tools:stats": "node scripts/fetch-tool-stats.mjs",
    "images:variants": "node scripts/generate-image-variants.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/aos": "^3.0.7",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.28",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "anymatch>picomatch": "^2.3.2",
      "diff": "^4.0.4",
      "glob": "^10.5.0",
      "graceful-fs": "^4.2.11",
      "minimatch": "^9.0.7",
      "micromatch>picomatch": "^2.3.2",
      "readdirp>picomatch": "^2.3.2",
      "rollup": "^4.59.0",
      "postcss-load-config>yaml": "^2.8.3",
      "vite>yaml": "^2.8.3",
      "undici": "^7.29.0",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "postcss-selector-parser": "^6.1.3"
    }
  }
}
