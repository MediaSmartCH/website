{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "components/*": [
        "src/components/*"
      ],
      "services/*": [
        "src/services/*"
      ],
      "config/*": [
        "src/config/*"
      ],
      "assets/*": [
        "src/assets/*"
      ],
      "store/*": [
        "src/store/*"
      ],
      "pages/*": [
        "src/pages/*"
      ],
    }
  },
  "include": [
    "src",
    "api/verify-recaptcha.ts"
  ]
}