{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "fluid": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/fr",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/fr",
      "destination": "/index.html"
    },
    {
      "source": "/en",
      "destination": "/index.html"
    },
    {
      "source": "/fr/it-services",
      "destination": "/index.html"
    },
    {
      "source": "/en/it-services",
      "destination": "/index.html"
    },
    {
      "source": "/fr/video-services",
      "destination": "/index.html"
    },
    {
      "source": "/en/video-services",
      "destination": "/index.html"
    },
    {
      "source": "/fr/privacy-policy",
      "destination": "/index.html"
    },
    {
      "source": "/en/privacy-policy",
      "destination": "/index.html"
    },
    {
      "source": "/fr/support-contract",
      "destination": "/index.html"
    },
    {
      "source": "/en/support-contract",
      "destination": "/index.html"
    },
    {
      "source": "/fr/404",
      "destination": "/index.html"
    },
    {
      "source": "/en/404",
      "destination": "/index.html"
    }
  ]
}
