{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "fluid": true,
  "git": {
    "deploymentEnabled": {
      "**": false,
      "production": true
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-site"
        },
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(self), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), usb=(), xr-spatial-tracking=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://www.google.com https://www.gstatic.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://va.vercel-scripts.com; frame-src https://www.google.com https://recaptcha.google.com https://www.recaptcha.net; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' data: blob:; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(screenshots|portfolio)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; sandbox"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/fr/video-services",
      "destination": "/fr",
      "statusCode": 301
    },
    {
      "source": "/en/video-services",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/fr/support-contract",
      "destination": "/fr",
      "statusCode": 301
    },
    {
      "source": "/en/support-contract",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/fr/it-services",
      "destination": "/fr/web-development",
      "statusCode": 301
    },
    {
      "source": "/en/it-services",
      "destination": "/en/web-development",
      "statusCode": 301
    },
    {
      "source": "/",
      "destination": "/fr",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/fr",
      "destination": "/generated-pages/fr.html"
    },
    {
      "source": "/en",
      "destination": "/generated-pages/en.html"
    },
    {
      "source": "/fr/web-development",
      "destination": "/generated-pages/fr-web-development.html"
    },
    {
      "source": "/en/web-development",
      "destination": "/generated-pages/en-web-development.html"
    },
    {
      "source": "/fr/privacy-policy",
      "destination": "/generated-pages/fr-privacy-policy.html"
    },
    {
      "source": "/en/privacy-policy",
      "destination": "/generated-pages/en-privacy-policy.html"
    },
    {
      "source": "/fr/legal-notice",
      "destination": "/generated-pages/fr-legal-notice.html"
    },
    {
      "source": "/en/legal-notice",
      "destination": "/generated-pages/en-legal-notice.html"
    },
    {
      "source": "/fr/terms",
      "destination": "/generated-pages/fr-terms.html"
    },
    {
      "source": "/en/terms",
      "destination": "/generated-pages/en-terms.html"
    },
    {
      "source": "/fr/404",
      "destination": "/generated-pages/fr-404.html"
    },
    {
      "source": "/en/404",
      "destination": "/generated-pages/en-404.html"
    },
    {
      "source": "/fr/(.*)",
      "destination": "/generated-pages/fr.html"
    },
    {
      "source": "/en/(.*)",
      "destination": "/generated-pages/en.html"
    }
  ],
  "crons": [
    {
      "path": "/api/booking/health",
      "schedule": "0 7 * * *"
    }
  ]
}
