{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "fluid": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/fr",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/fr",
      "destination": "/index.html"
    },
    {
      "source": "/en",
      "destination": "/index.html"
    },
    {
      "source": "/fr/it-services",
      "destination": "/index.html"
    },
    {
      "source": "/en/it-services",
      "destination": "/index.html"
    },
    {
      "source": "/fr/video-services",
      "destination": "/index.html"
    },
    {
      "source": "/en/video-services",
      "destination": "/index.html"
    },
    {
      "source": "/fr/privacy-policy",
      "destination": "/index.html"
    },
    {
      "source": "/en/privacy-policy",
      "destination": "/index.html"
    },
    {
      "source": "/fr/support-contract",
      "destination": "/index.html"
    },
    {
      "source": "/en/support-contract",
      "destination": "/index.html"
    },
    {
      "source": "/fr/404",
      "destination": "/index.html"
    },
    {
      "source": "/en/404",
      "destination": "/index.html"
    }
  ]
}
