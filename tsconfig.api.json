{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2023"
    ],
    "types": [
      "node",
      "vitest/globals"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "api/**/*",
    "scripts/**/*"
  ]
}
