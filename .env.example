VITE_RECAPTCHA_SITE_KEY=
REACT_APP_RECAPTCHA_SITE_KEY=
# Required server-side for /api/send and /api/newsletter.
RECAPTCHA_SECRET_KEY=
# Required server-side for all Resend-based email delivery.
RESEND_API_KEY=

# Required for CI or local API-based Vercel project sync.
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_TOKEN=

# Shared secret for the scheduled booking health check (/api/booking/health).
# Set the same value in the Vercel project env: Vercel Cron sends it as
# `Authorization: Bearer <value>`. Without it the endpoint refuses to answer in
# production.
CRON_SECRET=

# --- Abuse controls (api/_shared) -------------------------------------------
# Canonical public origin. Used to decide which Origin headers and which
# reCAPTCHA hostnames are accepted, and to build the booking manage links.
SITE_ORIGIN=https://mediasmart.ch
# Extra origins the site is served from, comma-separated. Optional.
ALLOWED_ORIGINS=
# Salt for the hashed abuse-counter keys. Falls back to BOOKING_HMAC_SECRET.
# Changing it resets every counter, which is safe but frees anyone currently
# rate-limited.
SECURITY_COUNTER_SALT=
# Minimum reCAPTCHA v3 score, 0..1. Defaults to 0.5. Raise only after watching
# the scores real submissions get: too high silently refuses real visitors.
RECAPTCHA_MIN_SCORE=
# Outbound mail ceilings. Defaults in api/_shared/outbound-mail-guard.ts.
CONTACT_CONFIRMATION_RECIPIENT_LIMIT=
CONTACT_CONFIRMATION_DAILY_LIMIT=
BOOKING_MAIL_RECIPIENT_LIMIT=
BOOKING_MAIL_DAILY_LIMIT=
