{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "fluid": true,
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://calendly.com https://*.calendly.com; object-src 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://va.vercel-scripts.com; frame-src 'self' https://calendly.com https://*.calendly.com https://www.google.com https://recaptcha.google.com https://www.recaptcha.net; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' data: blob: https:; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": {
            "suf": ".vercel.app"
          }
        }
      ],
      "destination": "https://mediasmart.ch/:path*",
      "statusCode": 308
    },
    {
      "source": "/",
      "destination": "/fr",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/fr",
      "destination": "/generated-pages/fr.html"
    },
    {
      "source": "/en",
      "destination": "/generated-pages/en.html"
    },
    {
      "source": "/fr/it-services",
      "destination": "/generated-pages/fr-it-services.html"
    },
    {
      "source": "/en/it-services",
      "destination": "/generated-pages/en-it-services.html"
    },
    {
      "source": "/fr/video-services",
      "destination": "/generated-pages/fr-video-services.html"
    },
    {
      "source": "/en/video-services",
      "destination": "/generated-pages/en-video-services.html"
    },
    {
      "source": "/fr/privacy-policy",
      "destination": "/generated-pages/fr-privacy-policy.html"
    },
    {
      "source": "/en/privacy-policy",
      "destination": "/generated-pages/en-privacy-policy.html"
    },
    {
      "source": "/fr/support-contract",
      "destination": "/generated-pages/fr-support-contract.html"
    },
    {
      "source": "/en/support-contract",
      "destination": "/generated-pages/en-support-contract.html"
    },
    {
      "source": "/fr/404",
      "destination": "/generated-pages/fr-404.html"
    },
    {
      "source": "/en/404",
      "destination": "/generated-pages/en-404.html"
    }
  ]
}
